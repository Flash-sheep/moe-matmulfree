{
  "experiment_name": "dense_baseline_full_finetune_5000step",
  "description": "Dense pretrained baseline continued for 5000 steps on SlimPajama with the same training protocol as sparse upcycling runs, but with all parameters trainable.",
  "dense_baseline": true,
  "seed": 42,
  "monitor_interval": 100,
  "moe": {
    "layer_indices": []
  },
  "freeze": {
    "freeze_embeddings": false,
    "freeze_lm_head": false,
    "freeze_token_mixer": false,
    "freeze_non_moe_mlp": false,
    "freeze_rmsnorm": false,
    "trainable_extra_patterns": []
  },
  "training": {
    "precision": "bf16",
    "device": "cuda",
    "batch_size": 2,
    "gradient_accumulation_steps": 16,
    "max_steps": 5000,
    "max_length": 2048,
    "learning_rate": 0.001,
    "min_lr": 0.0001,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "grad_clip": 1.0,
    "text_field": "text",
    "log_interval": 25,
    "eval_interval": 500,
    "save_interval": 1000,
    "max_eval_batches": 64,
    "max_val_samples": 1024
  }
}
