{
  "name": "phase2_ternary_expert_baseline",
  "goal": "Validate ternary expert MLP quantization in MoE without unacceptable quality loss.",
  "backbone": "HGRNBit",
  "use_moe": true,
  "moe_use_quantized_experts": true,
  "moe_num_experts": 4,
  "moe_num_experts_per_tok": 2,
  "moe_router_aux_loss_coef": 0.01,
  "moe_router_jitter_noise": 0.0,
  "moe_router_bias": false,
  "moe_normalize_topk_prob": true,
  "target_relative_ppl_degradation_max": 0.05,
  "success_metric": {
    "training_divergence": false,
    "expert_collapse": false,
    "repeatable_multi_seed": true
  }
}
