{
  "name": "phase1_fp_moe_baseline",
  "goal": "Establish a stable floating-point MoE baseline before ternary expert validation.",
  "backbone": "HGRNBit",
  "use_moe": true,
  "moe_use_quantized_experts": false,
  "moe_num_experts": 4,
  "moe_num_experts_per_tok": 2,
  "moe_router_aux_loss_coef": 0.01,
  "moe_router_jitter_noise": 0.0,
  "moe_router_bias": false,
  "moe_normalize_topk_prob": true,
  "success_metric": {
    "router_stability": true,
    "expert_usage_logged": true,
    "training_divergence": false
  }
}
